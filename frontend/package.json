{
  "name": "frontend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node server.js",
    "dev:client": "vite",
    "clean:vercel-assets": "node scripts/prepare-vercel.mjs clean",
    "build": "npm run clean:vercel-assets && tsc -b && npm run build:client && npm run build:server && node scripts/prepare-vercel.mjs copy",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build:static": "npm run clean:vercel-assets && tsc -b && vite build --outDir dist/static",
    "use:ssr": "cp vercel.ssr.json vercel.json",
    "use:static": "cp vercel.static.json vercel.json",
    "start": "NODE_ENV=production node server.js",
    "preview": "npm run build && npm run start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "swr": "^2.4.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
